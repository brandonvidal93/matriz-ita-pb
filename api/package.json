{
  "name": "matriz-ita-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API y servidor web de la Matriz ITA (MySQL).",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/servidor.ts",
    "build": "esbuild src/servidor.ts src/scripts/crear-admin.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outdir=dist --out-extension:.js=.mjs && cp -R src/migraciones dist/",
    "start": "node --env-file-if-exists=.env dist/servidor.mjs",
    "crear-admin": "tsx --env-file-if-exists=.env src/scripts/crear-admin.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.10",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.12.8",
    "mysql2": "^3.24.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2",
    "vitest": "^5.1.0"
  }
}
