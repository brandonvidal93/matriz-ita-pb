# Copia este archivo como api/.env y ajusta los valores.
ITA_DB_URL=mysql://ita:ita-dev-local@127.0.0.1:3307/matriz_ita
# Base para pruebas de integración (se BORRA su contenido en cada ejecución).
ITA_DB_TEST_URL=mysql://ita:ita-dev-local@127.0.0.1:3307/matriz_ita_test
ITA_PUERTO=3000
# En producción detrás de HTTPS: true. En local por http: false.
ITA_COOKIE_SEGURA=false
# Minutos de inactividad antes de cerrar la sesión. El sitio avisa 5 minutos antes.
# Más de 1200 (20 h) no requiere aviso según WCAG 2.2.1, pero el aviso sigue activo.
ITA_SESION_MINUTOS=480
# true si hay un proxy inverso (IIS, Nginx) delante de Node.
ITA_CONFIAR_PROXY=false
# Carpeta del build de Angular; vacío para servir solo la API.
# ITA_WEB_DIR=../dist/matriz-ita-pb/browser
